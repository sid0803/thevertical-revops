// backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Simulated Roles:
// "SUPER_ADMIN", "MANAGER", "TEAM_LEADER", "SALES_EXEC", "ACCOUNT_MANAGER", "FINANCE"

// Pipeline Stages (v2 - CEO approved):
// "DISCOVERY_CALL", "DEMO", "PROPOSAL", "NEGOTIATION", "WIN", "LOSS"

// Activity Types:
// "STAGE_CHANGE", "NOTE", "CALL", "EMAIL", "WHATSAPP"

// Meeting Types (after a call):
// "PHONE_CALL", "ONLINE_MEETING", "FACE_TO_FACE", "OFFICE_VISIT", "EMAIL_SENT", "WHATSAPP_MSG"

// Invoice Statuses:
// "DRAFT", "PARTIALLY_PAID", "PAID", "OVERDUE"

// Handoff Statuses:
// "PENDING", "IN_PROGRESS", "COMPLETED", "SLA_BREACHED"

// Task Types:
// "CALL", "MEETING", "EMAIL", "FOLLOW_UP", "DEMO", "OTHER"

// ─── USER & AUTH ──────────────────────────────────────

model User {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  password     String
  role         String
  isActive     Boolean        @default(true)
  teamLeaderId String?
  teamLead     User?          @relation("TeamMembers", fields: [teamLeaderId], references: [id])
  teamMembers  User[]         @relation("TeamMembers")
  assignedLeads Lead[]        @relation("AssignedLeads")
  activities   LeadActivity[]
  targetsSet   Target[]       @relation("TargetsSet")
  targetsFor   Target[]       @relation("TargetsFor")
  handoffs     Handoff[]
  tasks        Task[]
  uploadedFiles LeadFile[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

// ─── LEADS ────────────────────────────────────────────

model Lead {
  id              String         @id @default(cuid())
  name            String
  phone           String         @unique
  personalEmail   String?        @unique
  companyName     String?
  companyEmail    String?
  linkedinUrl     String?
  socialMediaUrl  String?
  source          String
  notes           String?
  stage           String         @default("DISCOVERY_CALL")
  lossReason      String?
  assignedToId    String?
  assignedTo      User?          @relation("AssignedLeads", fields: [assignedToId], references: [id])
  activities      LeadActivity[]
  tasks           Task[]
  files           LeadFile[]
  client          Client?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model LeadActivity {
  id           String       @id @default(cuid())
  leadId       String
  lead         Lead         @relation(fields: [leadId], references: [id])
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  type         String
  meetingType  String?
  description  String
  callDuration Int?
  createdAt    DateTime     @default(now())
}

// ─── TASKS ────────────────────────────────────────────

model Task {
  id           String    @id @default(cuid())
  leadId       String
  lead         Lead      @relation(fields: [leadId], references: [id])
  assignedToId String
  assignedTo   User      @relation(fields: [assignedToId], references: [id])
  title        String
  description  String?
  taskType     String    @default("FOLLOW_UP")
  dueDate      DateTime
  isCompleted  Boolean   @default(false)
  completedAt  DateTime?
  isOverdue    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ─── LEAD FILES ───────────────────────────────────────

model LeadFile {
  id           String   @id @default(cuid())
  leadId       String
  lead         Lead     @relation(fields: [leadId], references: [id])
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  fileName     String
  fileSize     Int
  filePath     String
  mimeType     String?
  uploadedAt   DateTime @default(now())
}

// ─── COMPANY PROFILE (for Proposal Letterhead) ────────

model CompanyProfile {
  id          String   @id @default(cuid())
  companyName String   @default("TheVertical.ai")
  address     String   @default("")
  city        String   @default("")
  state       String   @default("")
  pincode     String   @default("")
  gstNumber   String   @default("")
  phone       String   @default("")
  email       String   @default("")
  website     String   @default("")
  logoUrl     String?
  updatedAt   DateTime @updatedAt
}

// ─── CLIENTS ──────────────────────────────────────────

model Client {
  id           String      @id @default(cuid())
  leadId       String      @unique
  lead         Lead        @relation(fields: [leadId], references: [id])
  companyName  String
  contactName  String
  phone        String
  email        String
  state        String?
  amcStartDate DateTime?
  amcEndDate   DateTime?
  invoices     Invoice[]
  proposals    Proposal[]
  commitment   Commitment?
  handoff      Handoff?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

// ─── BILLING ──────────────────────────────────────────

model Invoice {
  id                String        @id @default(cuid())
  invoiceNumber     String        @unique
  clientId          String
  client            Client        @relation(fields: [clientId], references: [id])
  baseAmount        Float
  gstRate           Float
  gstAmount         Float
  totalAmount       Float
  paidAmount        Float         @default(0)
  outstandingAmount Float
  status            String        @default("DRAFT")
  slabs             PaymentSlab[]
  dueDate           DateTime?
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model PaymentSlab {
  id            String    @id @default(cuid())
  invoiceId     String
  invoice       Invoice   @relation(fields: [invoiceId], references: [id])
  slabNumber    Int
  percentage    Float
  amount        Float
  dueDate       DateTime?
  isPaid        Boolean   @default(false)
  paidAt        DateTime?
  paymentNote   String?
  createdAt     DateTime  @default(now())
}

// ─── PROPOSALS (PRICING BUILDER) ──────────────────────

model Proposal {
  id               String         @id @default(cuid())
  proposalNumber   String         @unique
  clientId         String?
  client           Client?        @relation(fields: [clientId], references: [id])
  clientName       String
  validityDays     Int            @default(15)
  lineItems        ProposalItem[]
  oneTimeTotal     Float          @default(0)
  monthlyTotal     Float          @default(0)
  consumptionTotal Float          @default(0)
  subtotal         Float          @default(0)
  gstRate          Float
  gstAmount        Float          @default(0)
  grandTotal       Float          @default(0)
  status           String         @default("DRAFT")
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model ProposalItem {
  id          String   @id @default(cuid())
  proposalId  String
  proposal    Proposal @relation(fields: [proposalId], references: [id])
  sortOrder   Int      @default(0)
  component   String
  description String?
  qty         Float    @default(1)
  costPerUnit Float
  totalAmount Float
  billingType String
  createdAt   DateTime @default(now())
}

// ─── SPLIT MAPPING ────────────────────────────────────

model Commitment {
  id                String   @id @default(cuid())
  clientId          String   @unique
  client            Client   @relation(fields: [clientId], references: [id])
  agentCount        Int
  talkTimeTarget    Int
  revenueCommitment Float
  windowStart       DateTime @default(now())
  windowEnd         DateTime
  actualTalkTime    Int      @default(0)
  actualRevenue     Float    @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Handoff {
  id                 String   @id @default(cuid())
  clientId           String   @unique
  client             Client   @relation(fields: [clientId], references: [id])
  accountManagerId   String
  accountManager     User     @relation(fields: [accountManagerId], references: [id])
  status             String   @default("PENDING")
  handoffDate        DateTime?
  meetingDone        Boolean  @default(false)
  introMailSent      Boolean  @default(false)
  onboardingDone     Boolean  @default(false)
  activationDone     Boolean  @default(false)
  slaBreached        Boolean  @default(false)
  slaDeadline        DateTime
  onboardingDeadline DateTime
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ─── TARGETS & INCENTIVES ─────────────────────────────

model Target {
  id             String   @id @default(cuid())
  assignedToId   String
  assignedTo     User     @relation("TargetsFor", fields: [assignedToId], references: [id])
  assignedById   String
  assignedBy     User     @relation("TargetsSet", fields: [assignedById], references: [id])
  month          String
  callTarget     Int
  talkTimeTarget Int
  revenueTarget  Float
  leadTarget     Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([assignedToId, month])
}
